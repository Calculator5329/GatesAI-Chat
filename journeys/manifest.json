{
  "schema": "agent-handles/journey/v1",
  "journeys": [
    {
      "name": "open-workspace-directly",
      "title": "Open the workspace URL directly",
      "description": "The shareable workspace path loads a usable composer with no prior navigation.",
      "kind": "url-path",
      "steps": [
        {
          "action": "navigate",
          "path": "/?scenario=desktop-ready#/workspace"
        },
        {
          "action": "expect",
          "testId": "workspace.composer.draft",
          "predicate": "visible"
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "disabled"
        }
      ]
    },
    {
      "name": "start-a-new-conversation",
      "title": "Start a fresh conversation",
      "description": "The sidebar control creates a thread and the composer is ready with the send control idle.",
      "kind": "control-path",
      "context": {
        "path": "/?scenario=desktop-ready#/workspace"
      },
      "steps": [
        {
          "action": "click",
          "testId": "workspace.editorial-sidebar.begin-a-new-conversation"
        },
        {
          "action": "expect",
          "testId": "workspace.composer.draft",
          "predicate": "visible"
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "disabled"
        }
      ]
    },
    {
      "name": "send-message-and-read-streamed-reply",
      "title": "Send a message and read the streamed reply",
      "description": "Type a prompt, send it, and watch the mocked OpenRouter stream land in the transcript.",
      "kind": "control-path",
      "context": {
        "path": "/?scenario=desktop-ready#/workspace"
      },
      "steps": [
        {
          "action": "fill",
          "testId": "workspace.composer.draft",
          "value": "Summarize the tour harness in one line."
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "enabled"
        },
        {
          "action": "click",
          "testId": "workspace.composer-input.composer-send-control"
        },
        {
          "action": "expect",
          "testId": "workspace.editorial-chat.stream",
          "predicate": "contains-text",
          "value": "The mocked OpenRouter stream answered this turn",
          "timeoutMs": 20000
        },
        {
          "action": "expect",
          "testId": "workspace.composer.draft",
          "predicate": "visible"
        }
      ]
    },
    {
      "name": "stop-a-slow-streamed-reply",
      "title": "Interrupt a slow reply",
      "description": "With a slow stream, the send control turns into stop; pressing it ends the turn and the composer goes idle.",
      "kind": "control-path",
      "context": {
        "path": "/?scenario=slow-stream#/workspace"
      },
      "steps": [
        {
          "action": "fill",
          "testId": "workspace.composer.draft",
          "value": "Tell me slowly."
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "enabled"
        },
        {
          "action": "click",
          "testId": "workspace.composer-input.composer-send-control"
        },
        {
          "action": "expect",
          "testId": "workspace.editorial-chat.stream",
          "predicate": "contains-text",
          "value": "This reply arrives slowly",
          "timeoutMs": 20000
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "enabled"
        },
        {
          "action": "click",
          "testId": "workspace.composer-input.composer-send-control"
        },
        {
          "action": "expect",
          "testId": "workspace.composer-input.composer-send-control",
          "predicate": "disabled"
        }
      ]
    },
    {
      "name": "tool-turn-shows-activity-and-answer",
